# ═══════════════════════════════════════════════════════════════
# ir/schema.yaml — Agent 操作面 (L2 + L3)
# ═══════════════════════════════════════════════════════════════
#
# 架构总纲 V1.1 四层权限:
#   L1 (topology + targets)  — 仅人可写，不在此文件
#   L2 (constraints + loss_terms) — Agent 可修改
#   L3 (evaluations)         — Agent 可修改
#   L4 (transistors)         — 仅脚本可写，不在此文件
#
# 此文件通过 main.py 的 apply_schema_overrides() 生效。
# Agent 修改此文件后运行 python main.py 触发新一轮内层循环。
#
# 约束格式 (新):
#   支持两种格式:
#     新格式 (平铺):  M1: {gm_id: [8, 20], L: [500n, 2u]}
#     旧格式 (嵌套):  gm_id: {min: 5, max: 25} + devices: {M1: {gm_id: {min: 8, max: 22}}}

schema_version: '2.0'
design_name: five_transistor_ota

# ═══════════════════════════════════════════════════════════════
# L2: 优化器约束 (搜索空间)
# ═══════════════════════════════════════════════════════════════
constraints:
  # ── 全局默认 ──
  gm_id:
    min: 5
    max: 25
  L:
    min: 1.3e-07
    max: 2.0e-06

  # ── 器件级约束 (覆盖全局) ──
  devices:
    M1:
      gm_id:
        min: 8
        max: 22
      L:
        min: 5.0e-07
        max: 2.0e-06
      initial_gm_id: 14
      initial_L: 1.0e-06
    M2:
      gm_id:
        min: 8
        max: 22
      L:
        min: 5.0e-07
        max: 2.0e-06
      initial_gm_id: 14
      initial_L: 1.0e-06
    M3:
      gm_id:
        min: 5
        max: 12
      L:
        min: 5.0e-07
        max: 2.0e-06
      initial_gm_id: 6
      initial_L: 2.0e-06
    M4:
      gm_id:
        min: 5
        max: 12
      L:
        min: 5.0e-07
        max: 2.0e-06
      initial_gm_id: 6
      initial_L: 2.0e-06
    M5:
      gm_id:
        min: 6
        max: 22
      L:
        min: 5.0e-07
        max: 2.0e-06
      initial_gm_id: 14
      initial_L: 1.0e-06

# ═══════════════════════════════════════════════════════════════
# L2: Loss 项 (formula + weight, Agent 可修改)
#
# 白名单变量: realized.*, targets.*, device.Mx.*
# 白名单函数: relu, abs, max, min, sqrt, pow, log10, penalty_if
# ═══════════════════════════════════════════════════════════════
loss_terms:
  - id: gain_deficit
    formula: relu(targets.dc_gain.min - realized.dc_gain)/max(targets.dc_gain.min, 1)
    weight: 0.8
    description: DC gain shortfall penalty
  - id: bw_deficit
    formula: relu(targets.unity_gain_bandwidth.min - realized.unity_gain_bandwidth)/max(targets.unity_gain_bandwidth.min, 1)
    weight: 0.6
    description: Bandwidth shortfall penalty
  - id: pm_deficit
    formula: relu(targets.phase_margin.min - realized.phase_margin)/max(targets.phase_margin.min, 1)
    weight: 4.0
    description: Phase margin soft penalty
  - id: power_ratio
    formula: realized.power/max(targets.power.max, 1e-9)
    weight: 0.5
    description: Power consumption penalty
  - id: cmrr_deficit
    formula: relu(targets.cmrr.min - realized.cmrr)/max(targets.cmrr.min, 1)
    weight: 0.6
    description: CMRR penalty
  - id: psrr_deficit
    formula: relu(targets.psrr_plus.min - realized.psrr_plus)/max(targets.psrr_plus.min, 1)
    weight: 0.4
    description: PSRR penalty

# ═══════════════════════════════════════════════════════════════
# L3: 评估声明 (测什么、怎么测, Agent 可修改)
#
# type 取值: ac_gain | ugbw | phase_margin | dc_power | cmrr | psrr | operating_region
# ═══════════════════════════════════════════════════════════════
evaluations:
  - name: dc_gain
    type: ac_gain
    probe: vout
    target_ref: dc_gain
  - name: unity_gain_bandwidth
    type: ugbw
    probe: vout
    target_ref: unity_gain_bandwidth
  - name: phase_margin
    type: phase_margin
    probe: vout
    target_ref: phase_margin
  - name: total_power
    type: dc_power
    target_ref: power
  - name: cmrr
    type: cmrr
    target_ref: cmrr
  - name: psrr_plus
    type: psrr
    target_ref: psrr_plus
